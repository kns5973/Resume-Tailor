# Resume Tailor — environment configuration
# Copy to .env and fill in real values:  cp .env.example .env

# Groq API key for live LLM calls (parse / match / build / verify / chat).
# Without one the pipeline runs on a deterministic MockLLMClient (offline mode).
GROQ_API_KEY=

# Optional: override the model tiers (defaults below)
# GROQ_MODEL_FAST=llama-3.1-8b-instant
# GROQ_MODEL_STRONG=llama-3.3-70b-versatile

# Force offline/mock mode even when a key is set
# RESUME_TAILOR_DRY_RUN=1

# Web app port (default 8000)
# RESUME_TAILOR_PORT=8177
